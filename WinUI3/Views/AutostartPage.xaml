<Page
    x:Class="BestWinTweaker.Views.AutostartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BestWinTweaker.Models">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="8">

        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Управление автозагрузкой"
                       FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Обновить" Command="{x:Bind ViewModel.RefreshCommand}"/>
            <Button Content="Выбрать все" Command="{x:Bind ViewModel.SelectAllCommand}"/>
            <Button Content="Снять все" Command="{x:Bind ViewModel.DeselectAllCommand}"/>
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:StartupEntry">
                    <Grid ColumnSpacing="8" Padding="8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox IsChecked="{x:Bind Enabled, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind Type}"
                                   Foreground="Orange" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind Source}"
                                   Foreground="Gray" VerticalAlignment="Center"
                                   FontSize="11"/>
                        <TextBlock Grid.Column="4" Text="{x:Bind Path}"
                                   Foreground="Gray" FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="6" Padding="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Применить изменения"
                        Command="{x:Bind ViewModel.ApplyChangesCommand}"
                        Background="SeaGreen" Foreground="White"/>
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           VerticalAlignment="Center" FontSize="13"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>