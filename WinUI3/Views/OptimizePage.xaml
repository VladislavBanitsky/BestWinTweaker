<Page
    x:Class="BestWinTweaker.Views.OptimizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:BestWinTweaker.Converters">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Page.Resources>

    <Grid RowDefinitions="*,Auto" Padding="16">
        <ScrollViewer>
            <StackPanel Spacing="16">
                <TextBlock Text="Инструменты оптимизации системы" VerticalAlignment="Center" Style="{StaticResource TitleTextBlockStyle}"/>
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Ряд 1 -->
                    <Button Content="Очистить временные файлы" Command="{x:Bind ViewModel.ClearTempCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="60" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>
                    <Button Grid.Column="1" Content="Отключить телеметрию" Command="{x:Bind ViewModel.DisableTelemetryCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="60" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>
                    <Button Grid.Column="2" Content="Очистить DNS кэш" Command="{x:Bind ViewModel.FlushDnsCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="60" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>

                    <!-- Ряд 2 -->
                    <Button Grid.Row="1" Content="Исправить обновления" Command="{x:Bind ViewModel.FixUpdatesCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="60" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="{x:Bind ViewModel.IndexingButtonText, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleIndexingCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="60" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="Скачать Windows" Command="{x:Bind ViewModel.DownloadWindowsCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="60" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>

                    <!-- Ряд 3 -->
                    <Button Grid.Row="2" Content="Установить обои Bing" Command="{x:Bind ViewModel.SetBingWallpaperCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="60" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="Удалить водяной знак" Command="{x:Bind ViewModel.RemoveWatermarkCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="60" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="Проверить пинг" Click="PingButton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="60"/>

                    <!-- Ряд 4 -->
                    <Button Grid.Row="3" Grid.Column="1" Content="Диспетчер устройств" Command="{x:Bind ViewModel.OpenDeviceManagerCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="60"/>
                    <Button Grid.Row="3" Grid.Column="2" Content="Управление дисками" Command="{x:Bind ViewModel.OpenDiskManagementCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="60" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>
                    <Button Grid.Row="3" Content="Диспетчер задач" Command="{x:Bind ViewModel.OpenTaskManagerCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="60"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Статусная строка -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        CornerRadius="6" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Привязка к StatusManager -->
                <TextBlock Text="{x:Bind ViewModel.Status.Text, Mode=OneWay}"
                   Foreground="{x:Bind ViewModel.Status.TextColor, Mode=OneWay}"
                   FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>

                <!-- Кнопка копирования -->
                <Button Grid.Column="1"
                Command="{x:Bind ViewModel.CopyPingResultCommand}"
                Visibility="{x:Bind ViewModel.HasPingResult, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                Background="Transparent" BorderThickness="0" Padding="8,4"
                ToolTipService.ToolTip="Копировать имя хоста">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>