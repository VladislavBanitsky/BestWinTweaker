<Page
    x:Class="BestWinTweaker.Views.MonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BestWinTweaker.Models">

    <ScrollViewer>
        <Grid Padding="20" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <!-- Левая колонка -->
                <ColumnDefinition Width="*"/>
                <!-- Правая колонка -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= ЛЕВАЯ КОЛОНКА ================= -->
            <StackPanel Grid.Column="0" Spacing="16">

                <!-- CPU -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="CPU — Центральный процессор"
                                   FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.CpuName, Mode=OneWay}"
                                   FontSize="14" TextWrapping="Wrap"/>
                        <ProgressBar Value="{x:Bind ViewModel.CpuUsage, Mode=OneWay}"
                                     Maximum="100" Height="10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.CoresText, Mode=OneWay}"
                                       FontSize="14"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20">
                                <TextBlock FontSize="14">
                                    <Run Text="Загрузка: "/>
                                    <Run Text="{x:Bind ViewModel.CpuUsage, Mode=OneWay}"/>
                                    <Run Text="%"/>
                                </TextBlock>
                                <TextBlock FontSize="14">
                                    <Run Text="Частота: "/>
                                    <Run Text="{x:Bind ViewModel.CpuFrequency, Mode=OneWay}"/>
                                    <Run Text=" MHz"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- RAM -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="RAM — Оперативная память"
                                   FontSize="16" FontWeight="SemiBold"/>
                        <ProgressBar Value="{x:Bind ViewModel.RamPercent, Mode=OneWay}"
                                     Maximum="100" Height="10"/>
                        <Grid>
                            <TextBlock FontSize="14">
                                <Run Text="Использовано: "/>
                                <Run Text="{x:Bind ViewModel.RamPercent, Mode=OneWay}"/>
                                <Run Text="%"/>
                            </TextBlock>
                            <TextBlock Text="{x:Bind ViewModel.RamUsageText, Mode=OneWay}"
                                       FontSize="14" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- GPU -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="GPU — Видеокарта" FontSize="16" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Gpus, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:GpuInfo">
                                    <StackPanel Spacing="4" Margin="0,4">
                                        <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold"/>
                                        <ProgressBar Value="{x:Bind LoadPercent}" Maximum="100" Height="8"/>
                                        <Grid>
                                            <TextBlock FontSize="14">
                                                <Run Text="Загрузка: "/>
                                                <Run Text="{x:Bind LoadPercent}"/>
                                                <Run Text="%  |  Температура: "/>
                                                <Run Text="{x:Bind TemperatureC}"/>
                                                <Run Text="°C  |  Память: "/>
                                                <Run Text="{x:Bind MemoryUsedMb}"/>
                                                <Run Text="/"/>
                                                <Run Text="{x:Bind MemoryTotalMb}"/>
                                                <Run Text=" MB"/>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ================= ПРАВАЯ КОЛОНКА ================= -->
            <StackPanel Grid.Column="1" Spacing="16">

                <!-- Материнская плата -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Материнская плата" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.BoardModel, Mode=OneWay}" 
                                   FontSize="14" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Сеть -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Сеть" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.NetworkAdapter, Mode=OneWay}" 
                                   FontSize="14" TextWrapping="Wrap"/>
                        <Grid>
                            <TextBlock FontSize="14">
                                <Run Text="Загрузка: "/>
                                <Run Text="{x:Bind ViewModel.DownloadSpeed, Mode=OneWay}"/>
                                <Run Text=" MB/s"/>
                            </TextBlock>
                            <TextBlock FontSize="14" HorizontalAlignment="Right">
                                <Run Text="Отдача: "/>
                                <Run Text="{x:Bind ViewModel.UploadSpeed, Mode=OneWay}"/>
                                <Run Text=" MB/s"/>
                            </TextBlock>
                        </Grid>
                        <Grid>
                            <TextBlock FontSize="14">
                                <Run Text="Всего скачано: "/>
                                <Run Text="{x:Bind ViewModel.TotalDownloadGb, Mode=OneWay}"/>
                                <Run Text=" GB"/>
                            </TextBlock>
                            <TextBlock FontSize="14" HorizontalAlignment="Right">
                                <Run Text="Всего отправлено: "/>
                                <Run Text="{x:Bind ViewModel.TotalUploadGb, Mode=OneWay}"/>
                                <Run Text=" GB"/>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Диски -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Диски" FontSize="16" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Disks, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DiskInfo">
                                    <StackPanel Spacing="4" Margin="0,4">
                                        <Grid>
                                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                                <Run Text="{x:Bind Device}"/>
                                                <Run Text=" ("/>
                                                <Run Text="{x:Bind DiskType}"/>
                                                <Run Text=")"/>
                                            </TextBlock>
                                        </Grid>
                                        <ProgressBar Value="{x:Bind Percent}" Maximum="100" Height="8"/>
                                        <TextBlock FontSize="14">
                                            <Run Text="Использовано: "/>
                                            <Run Text="{x:Bind Percent}"/>
                                            <Run Text="% ("/>
                                            <Run Text="{x:Bind UsedGb}"/>
                                            <Run Text="/"/>
                                            <Run Text="{x:Bind TotalGb}"/>
                                            <Run Text=" GB)"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>