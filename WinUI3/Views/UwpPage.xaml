<Page
    x:Class="BestWinTweaker.Views.UwpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BestWinTweaker.Models"
    xmlns:converters="using:BestWinTweaker.Converters">

    <Page.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Page.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="8">

        <!-- Панель управления -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Управление UWP-приложениями" 
                       FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Обновить" Command="{x:Bind ViewModel.LoadAppsCommand}" 
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>
            <Button Content="Выбрать безопасные" Command="{x:Bind ViewModel.SelectAllSafeCommand}"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>
        </StackPanel>

        <!-- Список приложений -->
        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Apps, Mode=OneWay}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:UwpApp">
                    <Grid ColumnSpacing="8" Padding="8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1" Text="{x:Bind Icon}" Foreground="{x:Bind IconColor}" 
                                   FontSize="16" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind Publisher}" Foreground="Gray" FontSize="10" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <TextBlock Grid.Column="3" Text="{x:Bind Version}" Foreground="Gray" 
                                   FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Нижняя панель -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                CornerRadius="6" Padding="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Удалить выбранные" Command="{x:Bind ViewModel.RemoveSelectedCommand}"
                        Background="IndianRed" Foreground="White"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                           VerticalAlignment="Center" FontSize="13"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>