<Page
    x:Class="BestWinTweaker.Views.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BestWinTweaker.Models"
    xmlns:converters="using:BestWinTweaker.Converters">

    <Page.Resources>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
    </Page.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="8">

        <!-- Панель управления -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBox PlaceholderText="Поиск по имени или PID..."
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="280"/>
            <CheckBox Content="Показывать системные"
                      IsChecked="{x:Bind ViewModel.ShowSystem, Mode=TwoWay}"/>
            <Button Content="Обновить" Command="{x:Bind ViewModel.RefreshCommand}"/>
            <Button Content="Завершить процесс"
                    Command="{x:Bind ViewModel.KillSelectedCommand}"
                    Background="IndianRed" Foreground="White"
                    IsEnabled="{x:Bind ViewModel.SelectedProcess, Mode=OneWay, Converter={StaticResource NullToBoolConverter}}"/>
        </StackPanel>

        <!-- Заголовки таблицы -->
        <Grid Grid.Row="1" ColumnSpacing="4" Padding="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="PID" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="Имя процесса" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="CPU %" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="3" Text="Память %" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="4" Text="Память МБ" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="5" Text="Статус" FontWeight="SemiBold"/>
        </Grid>

        <!-- Список процессов -->
        <ListView Grid.Row="2"
                  ItemsSource="{x:Bind ViewModel.Processes, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedProcess, Mode=TwoWay}"
                  SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ProcessInfo">
                    <Grid ColumnSpacing="4" Padding="8,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Pid}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind CpuPercent}"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind MemoryPercent}"/>
                        <TextBlock Grid.Column="4" Text="{x:Bind MemoryMb}"/>
                        <TextBlock Grid.Column="5" Text="{x:Bind StatusText}"
                                   Foreground="{x:Bind StatusColor}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>